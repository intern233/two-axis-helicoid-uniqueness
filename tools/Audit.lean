import TwoAxisHelicoidManuscript
import Lean.Util.CollectAxioms

open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let allowed := #[`propext, `Classical.choice, `Quot.sound]
  let scopes := #[`TwoAxisHelicoid.ManuscriptC1TheoremOneOne, `TwoAxisHelicoid.PlacedManuscriptC1TheoremOneOne, `TwoAxisHelicoid.ManuscriptC1UniqueImageClass, `TwoAxisHelicoid.ManuscriptGeometricTheoremOneOne, `TwoAxisHelicoid.OriginalGraphTheoremOneOne, `TwoAxisHelicoid.PlacedGraphTheoremOneOne,
    `TwoAxisHelicoid.OriginalPositionalTheoremOneOne, `TwoAxisHelicoid.PlacedPositionalJointTheoremOneOne]
  -- Collect exactly the declarations from the kernel environment in the
  -- original namespace scope. Visit each module's objects together so
  -- their read-only pages can be released before the next module.
  let other := env.header.modules.size
  let mut groups : Array (Array (Name × ConstantInfo)) := Array.replicate (other+1) #[]
  let mut expected := 0
  for (name, info) in env.constants do
    if (`TwoAxisHelicoid).isPrefixOf name then
      let group := (env.getModuleIdxFor? name).map (·.toNat) |>.getD other
      groups := groups.modify group (·.push (name, info))
      expected := expected+1
  let mut checked : Nat := 0
  for group in groups do
    for (name, info) in group do
      checked := checked + 1
      let dependencies ← collectAxioms name
      for ax in dependencies do
        unless allowed.contains ax do
          throwError "Unapproved axiom {ax} in {name}"
      if let .thmInfo thm := info then
        if let .const conclusion _ := thm.type.consumeMData then
          if scopes.contains conclusion then
            logInfo m!"Unconditional scope {conclusion} proved by {name}."
  unless checked == expected do
    throwError "Kernel environment contains {expected} TwoAxisHelicoid declarations, but {checked} were audited"
  if checked == 0 then
    throwError "No TwoAxisHelicoid declarations audited"
  logInfo m!"Axiom audit passed for {checked} TwoAxisHelicoid declarations. Allowed: propext, Classical.choice, Quot.sound."

