import TwoAxisHelicoid.FlatCylinderExponential
import TwoAxisHelicoid.CyclicCoordinateFibers

namespace TwoAxisHelicoid
open Complex Set Filter
open scoped Topology

/-- Precisely the three complex domains arising as cyclic quotients of the
plane and the disk. Finite annuli are normalized to reciprocal radii. -/
def IsRoundCylinderTarget (T : Set ℂ) : Prop :=
  T={z : ℂ | 0<‖z‖} ∨ T={z : ℂ | 0<‖z‖ ∧ ‖z‖<1} ∨
    ∃ R : ℝ, 1<R ∧ T={z : ℂ | R⁻¹<‖z‖ ∧ ‖z‖<R}

theorem IsRoundCylinderTarget.isOpen {T : Set ℂ} (h : IsRoundCylinderTarget T) : IsOpen T := by
  rcases h with rfl|rfl|⟨R,_,rfl⟩
  · exact isOpen_lt continuous_const continuous_norm
  · exact (isOpen_lt continuous_const continuous_norm).inter (isOpen_lt continuous_norm continuous_const)
  · exact (isOpen_lt continuous_const continuous_norm).inter (isOpen_lt continuous_norm continuous_const)

theorem exponential_linear_regular {k : ℂ} (hk : k≠0) (z : ℂ) :
    AnalyticAt ℂ (fun w => Complex.exp (k*w)) z ∧ deriv (fun w => Complex.exp (k*w)) z≠0 := by
  have d := (Complex.hasDerivAt_exp (k*z)).comp z ((hasDerivAt_id z).const_mul k)
  refine ⟨analyticAt_cexp.comp (analyticAt_const.mul analyticAt_id),?_⟩
  have hd : HasDerivAt (fun w => Complex.exp (k*w)) (Complex.exp (k*z)*k) z := by
    simpa only [Function.comp_def,id_eq,mul_one] using d
  exact hd.deriv.symm ▸ mul_ne_zero (Complex.exp_ne_zero _) hk

theorem horizontalCylinderMap_regular {s : ℝ} (hs : 0<s) (z : ℂ) :
    AnalyticAt ℂ (horizontalCylinderMap s) z ∧ deriv (horizontalCylinderMap s) z≠0 := by
  have eq : horizontalCylinderMap s=(fun w => Complex.exp ((I/(s:ℂ))*w)) := by
    funext w
    rw [horizontalCylinderMap,div_mul_eq_mul_div]
  rw [eq]
  exact exponential_linear_regular (div_ne_zero I_ne_zero (ofReal_ne_zero.mpr hs.ne')) z

theorem verticalCylinderMap_regular {s : ℝ} (hs : 0<s) (z : ℂ) :
    AnalyticAt ℂ (verticalCylinderMap s) z ∧ deriv (verticalCylinderMap s) z≠0 := by
  have eq : verticalCylinderMap s=(fun w => Complex.exp (((-1:ℂ)/(s:ℂ))*w)) := by
    funext w
    rw [verticalCylinderMap,div_mul_eq_mul_div,neg_one_mul]
  rw [eq]
  exact exponential_linear_regular (div_ne_zero (neg_ne_zero.mpr one_ne_zero) (ofReal_ne_zero.mpr hs.ne')) z

theorem analytic_regular_comp {F G : ℂ → ℂ} {z : ℂ}
    (g : AnalyticAt ℂ G z ∧ deriv G z≠0) (f : AnalyticAt ℂ F (G z) ∧ deriv F (G z)≠0) :
    AnalyticAt ℂ (F ∘ G) z ∧ deriv (F ∘ G) z≠0 :=
  ⟨f.1.comp g.1,by rw [deriv_comp z f.1.differentiableAt g.1.differentiableAt]; exact mul_ne_zero f.2 g.2⟩

theorem integer_shifts_same_up_to_sign {a b : ℂ} (e : a=b ∨ a= -b) (x y : ℂ) :
    (∃ n : ℤ, x=y+(n:ℂ)*a) ↔ ∃ n : ℤ, x=y+(n:ℂ)*b := by
  rcases e with rfl|rfl
  · rfl
  · constructor <;> rintro ⟨n,rfl⟩ <;> refine ⟨-n,?_⟩ <;> push_cast <;> ring

theorem abs_period_scale {b : ℝ} (hb : b≠0) :
    ∃ s : ℝ, 0<s ∧ (2*(Real.pi:ℂ)*(s:ℂ)=(b:ℂ) ∨ 2*(Real.pi:ℂ)*(s:ℂ)= -(b:ℂ)) := by
  let s := |b|/(2*Real.pi)
  have sk : 2*Real.pi*s=|b| := mul_div_cancel₀ _ (by positivity : 2*Real.pi≠0)
  refine ⟨s,div_pos (abs_pos.mpr hb) (by positivity),?_⟩
  rcases lt_or_gt_of_ne hb with neg|pos
  · right
    exact_mod_cast (sk.trans (abs_of_neg neg))
  · left
    exact_mod_cast (sk.trans (abs_of_pos pos))

/-- The exponential quotient of a translated complex plane has exact
image the punctured plane and period group generated by the deck step. -/
theorem plane_translation_quotient_parameter {c : ℂ} (hc : c≠0) :
    ∃ F : ℂ → ℂ, (∀ z, AnalyticAt ℂ F z ∧ deriv F z≠0) ∧
      F '' univ={z : ℂ | 0<‖z‖} ∧
      ∀ v w, F v=F w ↔ ∃ n : ℤ, v=w+(n:ℂ)*c := by
  let T : ℂ := 2*(Real.pi:ℂ)*I
  have nz : T≠0 := mul_ne_zero (mul_ne_zero (by norm_num) (ofReal_ne_zero.mpr Real.pi_ne_zero)) I_ne_zero
  let k := T/c
  have nk : k≠0 := div_ne_zero nz hc
  have per : k*c=T := div_mul_cancel₀ _ hc
  refine ⟨fun z => Complex.exp (k*z),exponential_linear_regular nk,?_,?_⟩
  · ext w
    constructor
    · rintro ⟨v,_,rfl⟩
      exact norm_pos_iff.mpr (Complex.exp_ne_zero _)
    · intro h
      refine ⟨Complex.log w/k,mem_univ _,?_⟩
      change Complex.exp (k*(Complex.log w/k))=w
      rw [mul_div_cancel₀ _ nk,Complex.exp_log (norm_pos_iff.mp h)]
  · intro v w
    rw [Complex.exp_eq_exp_iff_exists_int]
    constructor
    · rintro ⟨n,eq⟩
      refine ⟨n,mul_left_cancel₀ nk ?_⟩
      change k*v=k*w+(n:ℂ)*T at eq
      rw [eq,← per]
      ring
    · rintro ⟨n,rfl⟩
      refine ⟨n,?_⟩
      change k*(w+(n:ℂ)*c)=k*w+(n:ℂ)*T
      rw [← per]
      ring

end TwoAxisHelicoid
#print axioms TwoAxisHelicoid.plane_translation_quotient_parameter
