theorem firstSpatialDiskTrace_valid :
    let S := slopingFluxAnalyticSetup
    let p := TraceData.slopingFluxParams
    firstSpatialDiskTrace.Valid S p.height.interpret p.q.output.interpret p.abscissa.interpret p.coefficient.output.interpret := by decide +kernel

theorem firstDiskTail_valid :
    firstDiskTail.Checks slopingFluxAnalyticSetup.config (4/5) 1 2 5 1048576 := by decide +kernel

theorem firstDiskNumbers :
    let cfg := slopingFluxAnalyticSetup.config
    let w := firstSpatialDiskTrace
    let z := w.argument.toBall cfg.prec
    let v := fun j => (w.spatial j).output.toBall cfg.prec
    z.coarsens ⟨⟨1,0⟩,1/1000⟩ ∧ (∀ j, 2*(v j).radius≤1/4) ∧ (v 0).center.re+(v 0).radius≤ -2 ∧
      (TraceData.slopingFluxParams.height.interpret.toBall cfg.prec).coarsens (realInterval rootTLower rootTUpper) := by decide +kernel

