theorem factoredNodes32Checked : ∀ (k : Fin 32) (n : Fin 6), (factoredNodes32 k n).encloses (wavePhaseGrid n (Grid.ofRats (factoredNodes32X k) (factoredNodes32X k)))=true := by decide +kernel
theorem factoredNodes32Sound (k : Fin 32) (n : Fin 6) : (factoredNodes32 k n).Contains (wavePhase n (2*((k:ℝ)/32)-1)) := by
