theorem root_horizontal_sine_remainder {t : ℝ} {v : ℂ}
    (ht : 86/100 ≤ t) (hv : |v.im| ≤ 69/100) :
    ‖thetaJet t 0 v-thetaPartial t 0 1 v‖ ≤ (61/100 : ℝ) := by
  have hh := rootHorizontalTail.remainder_bound rootDyadicConfig (86/100) (69/100) 0 1 47536897508558602556126370202
    rootHorizontalTail_valid (by norm_num) (by simpa using ht) (by simpa using hv)
  apply hh.trans
  norm_num [rootDyadicConfig, DyadicBall.denominator]
