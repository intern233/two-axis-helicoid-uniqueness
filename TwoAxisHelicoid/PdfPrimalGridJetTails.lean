theorem pdf_primal_six_term_tail {t : ℝ} (ht : 17/20≤t) (j : Fin 5) {v : ℂ} (strip : |v.im|≤2) :
    ‖thetaJet t j v-thetaPartial t j 6 v‖≤1/2^25 := by
  let cfg : BallConfig := ⟨64,12,6⟩
  have checks : (pdfPrimalTailFamily j).Checks cfg (17/20) 2 j 6 (2^39) := by
    fin_cases j
    · exact pdfPrimalTail0_checks
    · exact pdfPrimalTail1_checks
    · exact pdfPrimalTail2_checks
    · exact pdfPrimalTail3_checks
    · exact pdfPrimalTail4_checks
  have h := (pdfPrimalTailFamily j).remainder_bound cfg (17/20) 2 j 6 (2^39) (DyadicThetaTail.valid_of_checks checks) (by norm_num) (by simpa only [Rat.cast_div,Rat.cast_ofNat] using ht) (by simpa using strip)
  convert h using 1
  norm_num [cfg,DyadicBall.denominator]

